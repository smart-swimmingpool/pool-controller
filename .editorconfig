# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
charset = utf-8

# C/C++ source
[*.{cpp,hpp,h,ino}]
indent_size = 2

# Structured data files
[*.{json,yml,yaml,js,ts,css}]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2

# Makefiles require tabs
[Makefile]
indent_style = tab

# Markdown/AsciiDoc: natural indentation varies (list bullets at 0, 2, 4;
# ordered-list sub-items at 3+, continuation at 4+), so indent_size is
# deliberately not enforced to avoid false positives.
[*.{md,adoc}]
indent_style = space
trim_trailing_whitespace = false
