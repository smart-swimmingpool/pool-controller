{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "platformio.ini",
          "search-regex": "FW_VERSION=\"[^\"]*\""
        },
        {
          "type": "generic",
          "path": "src/Version.h",
          "search-regex": "FW_VERSION \"[^\"]*\""
        }
      ]
    }
  }
}
